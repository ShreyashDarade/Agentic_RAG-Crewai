# Copy to .env (git-ignored) or provide the variables through the environment. No real values here.
# Every secret can instead be given as the path of a file that holds it, for mounted secrets:
# AGENTIC_RAG_OPENAI_API_KEY_FILE=/run/secrets/openai_api_key (set the variable or the _FILE form, not both).

# -- the server's own access: one or two keys (two while rotating); at least 16 characters each
AGENTIC_RAG_API_KEYS=

# -- providers
AGENTIC_RAG_OPENAI_API_KEY=
AGENTIC_RAG_CREWAI_LLM_API_KEY=
AGENTIC_RAG_CREWAI_EMBEDDER_API_KEY=

# -- vector stores
AGENTIC_RAG_MILVUS_URI=
AGENTIC_RAG_MILVUS_TOKEN=
AGENTIC_RAG_QDRANT_API_KEY=

# -- for a client talking to the server (the SDK reads this one; the server ignores it)
AGENTIC_RAG_API_KEY=
