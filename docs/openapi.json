          }
        },
        "required": [
          "document",
          "created",
          "chunks_indexed"
        ],
        "title": "IngestResult",
        "type": "object"
      },
      "ProblemDetails": {
        "additionalProperties": true,
        "description": "RFC 9457 problem details plus ``code`` and ``request_id``.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
