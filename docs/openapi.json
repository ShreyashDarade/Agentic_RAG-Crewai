{
  "components": {
    "schemas": {
      "Body_ingest_document": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_ingest_document",
        "type": "object"
      },
      "DeleteResult": {
        "additionalProperties": true,
        "properties": {
          "chunks_deleted": {
            "title": "Chunks Deleted",
            "type": "integer"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "chunks_deleted"
        ],
        "title": "DeleteResult",
        "type": "object"
      },
      "DocumentInfo": {
        "additionalProperties": true,
        "properties": {
          "chunk_count": {
            "title": "Chunk Count",
            "type": "integer"
          },
          "content_sha256": {
            "title": "Content Sha256",
            "type": "string"
          },
          "content_type": {
            "title": "Content Type",
            "type": "string"
          },
          "embedding_model": {
            "title": "Embedding Model",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "content_sha256",
          "content_type",
          "chunk_count",
          "embedding_model"
        ],
        "title": "DocumentInfo",
        "type": "object"
      },
      "DocumentList": {
        "additionalProperties": true,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/DocumentInfo"
            },
            "title": "Items",
            "type": "array"
          },
          "next_page_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Page Token"
          }
        },
        "required": [
          "items"
        ],
        "title": "DocumentList",
        "type": "object"
      },
      "IngestResult": {
        "additionalProperties": true,
        "properties": {
          "chunks_indexed": {
            "title": "Chunks Indexed",
