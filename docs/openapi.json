              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "chunk_id",
          "document_id",
          "text",
          "score"
        ],
        "title": "SearchHit",
        "type": "object"
      },
      "SearchRequest": {
        "additionalProperties": false,
        "description": "Retrieve ranked chunks without generating an answer.",
        "properties": {
          "document_ids": {
            "anyOf": [
              {
                "items": {
                  "pattern": "^[A-Za-z0-9._-]{1,128}$",
                  "type": "string"
                },
                "maxItems": 100,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Ids"
          },
          "query": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "top_k": {
            "anyOf": [
              {
                "maximum": 50.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Top K"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearchRequest",
        "type": "object"
      },
      "SearchResponse": {
        "additionalProperties": true,
        "properties": {
          "hits": {
            "items": {
              "$ref": "#/components/schemas/SearchHit"
