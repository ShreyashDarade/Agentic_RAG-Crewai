            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "QueryRequest": {
        "additionalProperties": false,
        "description": "Ask a question over the indexed documents.",
        "properties": {
          "document_ids": {
            "anyOf": [
              {
                "items": {
                  "pattern": "^[A-Za-z0-9._-]{1,128}$",
                  "type": "string"
                },
                "maxItems": 100,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Ids"
          },
          "question": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "top_k": {
            "anyOf": [
              {
                "maximum": 50.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Top K"
          }
        },
        "required": [
          "question"
        ],
        "title": "QueryRequest",
        "type": "object"
      },
      "QueryResponse": {
        "additionalProperties": true,
        "description": "An answer with the chunks it cites.\n\n``grounded`` is ``False`` when nothing relevant was retrieved: ``answer`` then states that, no\nmodel was asked, and ``citations`` is empty.",
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "citations": {
            "description": "chunk ids, all present in sources",
            "items": {
              "type": "string"
            },
            "title": "Citations",
            "type": "array"
          },
          "grounded": {
            "title": "Grounded",
            "type": "boolean"
          },
          "pipeline": {
            "title": "Pipeline",
            "type": "string"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "answer",
          "grounded",
          "pipeline"
        ],
        "title": "QueryResponse",
        "type": "object"
      },
      "ReadyResponse": {
        "additionalProperties": true,
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          }
        },
        "required": [
          "ready"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "SearchHit": {
        "additionalProperties": true,
        "properties": {
          "chunk_id": {
            "title": "Chunk Id",
            "type": "string"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
